{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec expo export -p web",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/server/**"
    },
    "api/[...path].js": {
      "includeFiles": "dist/server/**"
    }
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/products/:productSlug",
      "destination": "/api/index?__expoPath=/products/:productSlug"
    },
    {
      "source": "/stores/:storeSlug",
      "destination": "/api/index?__expoPath=/stores/:storeSlug"
    },
    {
      "source": "/categories/:categorySlug",
      "destination": "/api/index?__expoPath=/categories/:categorySlug"
    },
    {
      "source": "/product/:productId",
      "destination": "/api/index?__expoPath=/product/:productId"
    },
    {
      "source": "/store/:sellerId",
      "destination": "/api/index?__expoPath=/store/:sellerId"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__expoPath=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__expoPath=/robots.txt"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/_expo/(.*)",
      "destination": "/_expo/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/",
      "destination": "/api/index?__expoPath=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__expoPath=/:path*"
    }
  ]
}
