{
  "expo": {
    "name": "tagit",
    "slug": "tagit",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/express.png",
    "userInterfaceStyle": "light",
    "scheme": "expressmart",
    "experiments": {
      "baseUrl": "/"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.stephenj3.ExpressMart",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stephenj.expressmart",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "com.google.android.c2dm.permission.RECEIVE"
      ],
          "intentFilters": [
            {
              "action": "VIEW",
              "data": [
               
                {
                  "scheme": "expressmart"
                }
              ],
              "category": [
                "BROWSABLE",
                "DEFAULT"
              ]
            }
          ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/express.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/express.png",
          "color": "#ffffff",
          "androidMode": "default",
          "androidCollapsedTitle": "tagit"
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-asset",
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#B7B8BF",
          "darkMode": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "#B7B8BF",
          "translucent": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d2e5bd63-b4f5-4a61-b288-f7549e59d7c9"
      },
      "firebaseApiKey": "AIzaSyBqrV1yGWsLj17JXFwfIWRP-sqX6hp8vLk",
      "firebaseAuthDomain": "expressmart-7d550.firebaseapp.com",
      "firebaseProjectId": "expressmart-7d550",
      "firebaseStorageBucket": "expressmart-7d550.firebasestorage.app",
      "firebaseMessagingSenderId": "499123636329",
      "firebaseAppId": "1:499123636329:web:9a96c3d4b6ed11c3f57af8",
      "firebaseVapidKey": "YOUR_VAPID_KEY",
      "measurementId": "G-Q63D7TJQRK"
    }
  }
}
