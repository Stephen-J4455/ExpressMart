{
  "expo": {
    "name": "tagit",
    "slug": "tagit",
    "version": "2.0.1",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "expressmart",
    "experiments": {
      "baseUrl": "/"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.stephenj.tagit",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:tagitshop.online",
        "applinks:www.tagitshop.online"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stephenj.tagit",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "com.google.android.c2dm.permission.RECEIVE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "expressmart"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tagitshop.online",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "www.tagitshop.online",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "tagitshop.online",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "www.tagitshop.online",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "tagitshop.online",
              "pathPrefix": "/wa/callback"
            },
            {
              "scheme": "https",
              "host": "www.tagitshop.online",
              "pathPrefix": "/wa/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/ico.webp"
    },
    "plugins": [
      "./plugins/withMedia3Fix",
      "./plugins/withCmakeObjectPathMax",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "androidMode": "default",
          "androidCollapsedTitle": "tagit"
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF5A79",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "expo-audio",
      "react-native-compressor",
      [
        "expo-router",
        {
          "origin": "https://tagitshop.online",
          "unstable_useServerRendering": true,
          "unstable_useServerDataLoaders": true
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "aac19ddf-69df-45d7-a714-78f42558b146"
      }
    }
  }
}
