# ── Cloudflare R2 (S3-compatible) ────────────────────────────────────────────
# Used by server-side tooling (transcode-server, migration script).
# Client apps NEVER hold these — they use the get-r2-upload-url edge function.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=expressmart-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Public CDN domain mapped to the R2 bucket (Cloudflare custom domain or Worker)
R2_PUBLIC_DOMAIN=https://cdn.expressmart.com

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://meiljgoztnhnyvtfkzuh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only!

# ── WhatsApp / Meta Commerce webhook (edge function secrets) ────────────────
# Set on the edge function via: supabase secrets set WHATSAPP_VERIFY_TOKEN=... WHATSAPP_APP_SECRET=...
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token   # must match Meta App dashboard subscription
WHATSAPP_APP_SECRET=your-meta-app-secret          # used to verify X-Hub-Signature-256
